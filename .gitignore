.sandbox.env

# Local image staging and one-off probe scripts
.layer-out/
.tmp-probe/

# One-off probes and captured live sessions.
# `.tmp-oppo-sessions.json` alone is 354KB of real cookies from a production target —
# these are working notes, not source. 2026-11-05 audit.
.tmp-*

# Local build tarball (shipped separately)
nianyun-dist.tar
*.tar

# Generated tool manifest (npm run build:manifest).
# 目录整体忽略，但把 manifest 本身纳入版本库：test/tool-manifest.test.ts 要读落盘文件，
# CI 的 `git diff --exit-code generated/tool-manifest.json` 也需要它是 tracked 才能检出漂移。
/generated/*
!/generated/tool-manifest.json

# Captured target assets and screenshot/GIF scratch dirs.
# h02tmp is 141MB of PNG/GIF frames, h04tmp is real bundle JS from a live target.
/h02tmp/
/h04tmp/

# Per-run workspace and reports hold live cookies/session dumps
/workspace/
/reports/

# WorkBuddy local workspace (agent notes, backups, staged image): local-only,
# never part of the published repository.
.workbuddy/

