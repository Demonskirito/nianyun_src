# Copy to .env (git-ignored). First launch can also start empty and use the console Settings UI.
# GHCR namespaces must be lowercase even when the GitHub account is not.
NIANYUN_IMAGE=ghcr.io/demonskirito/nianyun:latest
NIANYUN_BIND=127.0.0.1
# On Windows, Hyper-V/WSL may reserve 8205-8904; if binding 8700 fails with
# "forbidden by its access permissions", use a free port such as 18700.
NIANYUN_PORT=8700
# serve = read-only console (tool execution returns 403); execute = allow asset
# discovery, probing and blackbox tools. The config template deliberately does
# not pin a mode, so this variable is the single source of truth.
NIANYUN_MODE=serve

# Sidecar sandbox service: it refuses to start without a token (or an explicit
# SANDBOX_ALLOW_ANON=true on a dev box). The control plane uses the same token.
# Generate one with: openssl rand -hex 24
SANDBOX_URL=http://sandbox:8790
SANDBOX_TOKEN=
SANDBOX_ALLOW_ANON=false
# Egress upstream for job containers (Burp / MITM). Without it jobs have no network.
BURP_PROXY_URL=http://host.docker.internal:8080

# Only used to initialize credentials on the first launch of a NEW data volume.
# Later edits are made in the console and persist in the data volume.
BLACKBOX_AGENT_BASE_URL=
BLACKBOX_AGENT_MODEL=
BLACKBOX_AGENT_API_KEY=
ASSET_AGENT_BASE_URL=
ASSET_AGENT_MODEL=
ASSET_AGENT_API_KEY=

# ── Optional ARL discovery stack ──────────────────────────────────────────
# Only needed for `docker compose -f compose.yaml --profile arl up -d`.
# The control plane starts without any of these; ARL_TOKEN is also the token
# the control plane sends to ARL over HTTP.
ARL_URL=http://arl-web:5003
ARL_TOKEN=
# Third-party image pinned by digest. Verify its provenance before updating.
ARL_IMAGE=honmashironeko/arl-docker-all@sha256:f86d4a7167f35abad7b92ebdb9d10fab226d2c2bd137dadb21281aa1a5f25333
# Generate strong values, e.g. ARL_TOKEN=$(openssl rand -hex 24).
# The ARL entrypoint refuses to start if any of these four are empty.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
ARL_BIND=127.0.0.1
ARL_PORT=5003
# Network created by `docker compose -f compose.yaml --profile arl up -d`.
# Only used when attaching compose.control.yaml via compose.control.arl.yaml.
NIANYUN_ARL_NETWORK=nianyun_default
