{
  "name": "nianyun",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "description": "Nianyun SRC asset discovery and blackbox session control plane in TypeScript.",
  "bin": {
    "nianyun": "./bin/nianyun",
    "nianyun-mcp": "./bin/nianyun-mcp",
    "nianyun-sandbox": "./bin/nianyun-sandbox"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:manifest && npm run build:console",
    "build:server": "tsc -p tsconfig.json",
    "build:manifest": "node scripts/gen-tool-manifest.mjs",
    "build:console": "npm --prefix console run build",
    "test": "vitest run",
    "sandbox:image": "docker build -f deploy/sandbox/Dockerfile.job -t nianyun:sandbox deploy/sandbox",
    "sandbox:image:scanner": "docker build -f deploy/sandbox/Dockerfile.scanner -t nianyun:sandbox-scanner deploy/sandbox",
    "sandbox:image:service": "docker build -f deploy/sandbox/Dockerfile -t nianyun:sandbox-service .",
    "sandbox:images": "npm run build:server && node scripts/build-sandbox-images.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.55.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

